#AWS configuration
AWS_ACCESS_KET_ID= your aws secret key
AWS_SECRET_ACCESS_KEY= your aws access key
AWS_REGION="us-east-1"
A#_BUCKET=atlas-enterprises-ai-27 


#AWS bedrock model configuration
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

#pinecone vectore database configuration
PINECONE_API_KEY= your pinecone api key
PINCONE_INDEX_HOST="atlas-enterprises-ai-index"
PINCONE_CLOUD=aws
PINCONE_REGION=us-east-1
PINCONE_READY_TIMEOUT=180
 
#postgres database configruration
DATABASE_URL= your postgres database url

#rius observagtion configuration
RIUS_API_KEY=your rius api key
RIUS_SERVICE_NAME="atlas-enterprises-ai"
RIUS_DISABLE=false
RIUS_CAPTURE_CONTENT=false